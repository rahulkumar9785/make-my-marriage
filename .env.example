# Required for signup, login, private workspaces, and password recovery.
# Copy to .env.local and enter development values. Never commit .env.local.
APP_URL=http://localhost:3000
MONGODB_URI=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# At least 32 characters. Keep stable; rotation invalidates sessions and reset links.
AUTH_SECRET=

# Resend API key and a sender on your verified domain.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <hello@your-verified-domain.com>"

# Use separate development, Preview, and production credentials.
# Production APP_URL must be the actual HTTPS origin, with no path or query.
# MongoDB must support transactions (Atlas or a local replica set).
# Never prefix server secrets with NEXT_PUBLIC_.
